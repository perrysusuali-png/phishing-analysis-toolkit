# Copy this file to ".env" and fill in your own key.
# Get a free VirusTotal API key at: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500 requests/day — the toolkit self-throttles to stay under this.
VT_API_KEY=

# Only used by app.py (web dashboard) for Flask session signing.
# Set this to a long random string before deploying anywhere other than your own machine.
TOOLKIT_SECRET_KEY=dev-only-change-me

# Controls who can reach the web dashboard:
#   127.0.0.1 (default) = only this PC
#   0.0.0.0             = any device on your local network (find this PC's
#                          IP with `ipconfig` on Windows, look for IPv4 Address)
HOST=127.0.0.1
PORT=5000

# Keep this "true" for local development. Set to "false" before setting
# HOST=0.0.0.0 or deploying anywhere reachable by other people — Flask's
# debug mode exposes an interactive code debugger that is NOT safe to
# expose beyond your own machine.
FLASK_DEBUG=true
